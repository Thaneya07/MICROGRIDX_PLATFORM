# Copy this file to .env and adjust values for your environment.
# Never commit a real .env file — it is excluded via .gitignore.

# --- PostgreSQL (used directly by the postgres service, and to build
#     BACKEND_DATABASE_URL below) ---
POSTGRES_USER=microgridx
POSTGRES_PASSWORD=changeme
POSTGRES_DB=microgridx
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Full SQLAlchemy connection URL used by the backend service. When running
# via docker-compose this should point at the `postgres` service name
# rather than localhost.
DATABASE_URL=postgresql+psycopg2://microgridx:changeme@postgres:5432/microgridx

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite/React) ---
FRONTEND_PORT=5173
# Base URL the browser uses to reach the backend API.
VITE_API_BASE_URL=http://localhost:8000
